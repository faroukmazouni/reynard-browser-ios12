CURRENT_VERSION = 0.5.0
CURRENT_BUILD = UNKNOWN

// iOS 12.1.1 is the oldest version supported by the sideload build.  Keep
// this aligned with Gecko, libimobiledevice and the IPA helper binary.
IPHONEOS_DEPLOYMENT_TARGET = 12.0
ARCHS = arm64
VALID_ARCHS = arm64

ENABLE_BITCODE = NO

GECKO_DIST = $(SRCROOT)/../engine/firefox/obj-aarch64-apple-ios/dist

HEADER_SEARCH_PATHS = $(inherited) $(GECKO_DIST)/include $(GECKO_DIST)/include/GeckoView $(SRCROOT)/GeckoView
LIBRARY_SEARCH_PATHS = $(inherited) $(GECKO_DIST)/bin
FRAMEWORK_SEARCH_PATHS = $(inherited) $(BUILT_PRODUCTS_DIR)
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
// These frameworks are imported for features that are availability-gated at
// iOS 13/14.  They must be weak-linked: a normal load command makes dyld try
// to load a framework that is absent on iOS 12 before any `#available` check
// can run.
// Xcode 15's new linker can turn weak references into crashing imports on
// iOS 14 and older. Use its classic linker for this back-deployment build.
OTHER_LDFLAGS = $(inherited) -Wl,-ld_classic -weak_framework PhotosUI -weak_framework QuickLookThumbnailing -weak_framework UniformTypeIdentifiers
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Reynard/Bridging/Reynard-Bridging-Header.h
